# NP-Harness local restore environment
# Copy to .env only if your shell tooling loads it. Pi itself does not require this file.

# Optional override for the target Pi agent directory used by scripts/render-settings.mjs.
PI_AGENT_DIR="$HOME/.pi/agent"

# Pi's native config directory override. Leave unset unless you intentionally use a non-default Pi config path.
# PI_CODING_AGENT_DIR="$HOME/.pi/agent"

# Example MCP placeholders used by mcp.example.json. Replace names/values for real local MCP servers.
EXAMPLE_API_KEY=""
EXAMPLE_API_TOKEN=""
